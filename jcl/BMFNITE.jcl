//BMFNITE  JOB (ACCT,BMF),'BMF NIGHTLY CYCLE',CLASS=A,
//             MSGCLASS=X,MSGLEVEL=(1,1),REGION=4096K,
//             NOTIFY=&SYSUID,RESTART=*
//*
//*  BMF NIGHTLY SETTLEMENT CYCLE
//*  EACH STEP IS CONDITIONED ON ALL PRIOR STEPS COMPLETING
//*  WITH RC 4 OR LESS.  RESTART AT THE FAILING STEP.
//*
//JOBLIB   DD DSN=TAX.BMF.LOADLIB,DISP=SHR
//*
//* ---- STEP 010 BMF ENTITY VALIDATION
//S010     EXEC PROC=BMFSTEP,PGM=ENTVAL
//*
//* ---- STEP 020 DUPLICATE FILING CONDITION
//S020     EXEC PROC=BMFSTEP,PGM=DUPCHK
//*
//* ---- STEP 030 STATUTE DATE COMPUTATION
//S030     EXEC PROC=BMFSTEP,PGM=STATCALC
//*
//* ---- STEP 040 FAILURE TO DEPOSIT PENALTY
//S040     EXEC PROC=BMFSTEP,PGM=FTDCALC
//*
//* ---- STEP 050 FAILURE TO FILE / FAILURE TO PAY
//S050     EXEC PROC=BMFSTEP,PGM=PENCALC
//*
//* ---- STEP 060 CORPORATE ESTIMATED TAX PENALTY
//S060     EXEC PROC=BMFSTEP,PGM=ESTPEN
//*
//* ---- STEP 070 FREEZE CONDITION EVALUATION
//S070     EXEC PROC=BMFSTEP,PGM=FRZEVAL
//*
//* ---- STEP 080 OVERPAYMENT INTEREST
//S080     EXEC PROC=BMFSTEP,PGM=OVPINT
//*
//* ---- STEP 090 REFUND OFFSET
//S090     EXEC PROC=BMFSTEP,PGM=OFFSET
//*
//* ---- STEP 100 COMBINED ANNUAL WAGE REPORTING MATCH
//S100     EXEC PROC=BMFSTEP,PGM=CAWRMTCH
//*
//* ---- STEP 110 NOTICE SELECTION AND GENERATION
//S110     EXEC PROC=BMFSTEP,PGM=NOTGEN
//*
//* ---- END OF CYCLE
