//BMFGDG   JOB (ACCT,BMF),'DEFINE GDG BASES',CLASS=A,
//             MSGCLASS=X,MSGLEVEL=(1,1),REGION=1024K,
//             NOTIFY=&SYSUID
//*
//* ONE TIME SETUP.  DEFINES THE GENERATION DATA GROUP BASES USED BY
//* THE NIGHTLY CYCLE.  RERUN ONLY AFTER A CATALOG REBUILD.
//*
//DEFGDG   EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE GDG (NAME(TAX.BMF.MODULE)           -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.MODULE.DUP)       -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.MODULE.STAT)      -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.MODULE.FTD)       -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.MODULE.PEN)       -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.MODULE.EST)       -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.MODULE.FRZ)       -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.MODULE.INT)       -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.MODULE.OFF)       -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.ENTITY.VALID)     -
              LIMIT(5) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.TRANS)            -
              LIMIT(10) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.NOTICE)           -
              LIMIT(10) SCRATCH NOEMPTY)
//*
//* REJECT GENERATIONS ARE KEPT LONGER.  RUN CONTROL PULLS THE LAST
//* THIRTY CYCLES WHEN RESEARCHING A REJECT.
//*
//DEFRJ    EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE GDG (NAME(TAX.BMF.ENTVAL.REJECTS)   -
              LIMIT(30) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(TAX.BMF.DUPCHK.REJECTS)   -
              LIMIT(30) SCRATCH NOEMPTY)
//*
